# QuantumShield Backend Configuration
PORT=5001
NODE_ENV=production

# Database Connection (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/quantumshield

# Authentication
JWT_SECRET=quantumshield_production_secret_change_me_in_real_deployment_32chars
JWT_EXPIRES_IN=24h

# Security & CORS
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_MB=25

# Optional Gemini API Key (falls back to built-in expert cryptographer engine if omitted)
GEMINI_API_KEY=
