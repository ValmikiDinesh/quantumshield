# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/quantumshield

# Authentication Secrets
JWT_SECRET=quantumshield_production_secret_change_me_in_real_deployment_32chars
JWT_EXPIRES_IN=24h

# Security & CORS
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_MB=250

# Optional AI Explanation Provider (Google Gemini API)
# Leave empty to use the built-in deterministic expert cryptographer engine
GEMINI_API_KEY=

# Razorpay Payment Gateway Configuration (for quantumshieldscan.com)
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=

